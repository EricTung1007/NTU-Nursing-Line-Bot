# LINE Bot Credentials (get from https://developers.line.biz/console/)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# LINE User IDs
LINE_ADMIN_USER_ID=your_admin_user_id_here
LINE_NOTIFY_USER_IDS=user_id_1,user_id_2
LINE_ACTIVE_USER_IDS=user_id_1

# LM Studio Server (default: local)
LM_STUDIO_HOST=http://127.0.0.1:1234

# LM Studio model IDs. Copy these exactly from TEST_LM_STUDIO.bat output.
EMBEDDING_MODEL=text-embedding-bge-small-zh-v1.5
CHAT_MODEL=your_loaded_chat_model_id_here

# Flask webhook server.
# Change FLASK_PORT if 5001 is already used on the deployment computer.
# This is the port for incoming LINE webhook traffic through Cloudflare.
FLASK_PORT=5001
# Keep 0.0.0.0 unless the local network/security policy requires another bind address.
FLASK_HOST=0.0.0.0
# Keep 127.0.0.1 for Cloudflare tunnel to reach Flask on this same computer.
FLASK_TUNNEL_HOST=127.0.0.1

# Optional local machine overrides.
# macOS default: /Users/<you>/.lmstudio/bin/lms
# Windows default: C:\Users\<you>\.lmstudio\bin\lms.exe
# LMS_CLI_PATH=/Users/your_name/.lmstudio/bin/lms

# Hospital/locked-down Windows environments:
# set these to false to prevent the bot from starting LM Studio or loading
# models through lms.exe. Start LM Studio and load models manually instead.
LM_STUDIO_AUTO_START=false
LM_STUDIO_AUTO_LOAD_MODELS=false

# Optional: use this when `lms load` needs a model file/path instead of CHAT_MODEL.
# CHAT_MODEL_KEY=/Users/your_name/.lmstudio/models/provider/model/model.gguf
