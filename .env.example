# LINE Bot Credentials (get from https://developers.line.biz/console/)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# LINE User IDs
LINE_ADMIN_USER_ID=your_admin_user_id_here
LINE_NOTIFY_USER_IDS=user_id_1,user_id_2
LINE_ACTIVE_USER_IDS=user_id_1

# LM Studio Server (default: local)
LM_STUDIO_HOST=http://127.0.0.1:1234
